# Copy this file to `.env` and fill in your real values.
# The app loads these automatically via python-dotenv (see config.py).

# --- Twilio (accident SMS alerts) ---
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH=your_twilio_auth_token
# Leave blank to auto-detect a number on your account, or set +1XXXXXXXXXX
TWILIO_FROM=
# Recipient phone number (must be verified on a Twilio trial account)
TWILIO_TO=+91XXXXXXXXXX
